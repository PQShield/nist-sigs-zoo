#!/usr/bin/env bash
# Run a command inside a throwaway, network-less container.
#
#   scripts/ngcc-run <cmd ...>      run <cmd> in /work (the repo, read-only)
#   scripts/ngcc-run --self-test    verify the sandbox (PASS/FAIL per check)
#
# All builds, KAT replays, `--sizes` extraction and smoke benchmarks of NGCC
# candidate code (untrusted) must go through this wrapper, never the host.
#
# Isolation: --network none, all capabilities dropped, no-new-privileges, pid
# and memory limits, repo mounted read-only; only the OUT_DIRS/OUT_FILES below
# are writable. Extracted NGCC sources/specs are mounted read-only.
#
# Env: BENCH_ITER, BENCH_CYCLES, BENCH_CPU are forwarded if set.
#      NGCC_DOCKER overrides the docker command (default: docker); a
#      `sg docker -c "scripts/ngcc-run ..."` invocation works as well.
#
# Caveat: perf counters (rdpmc / perf_event_open) are usually unavailable in
# the container, so cycle counts fall back to rdtsc. Local runs are smoke
# tests only; real numbers come from scripts/aws-bench.sh.
set -euo pipefail

# Writable bind mounts (relative to the repo root). Everything else is ro.
OUT_DIRS=(
    bench/build
    bench/results
    bench/schemes/ngcc/build
    bench-kem/build
    bench-kem/results
    bench-kem/schemes/ngcc/build
)
# Writable single files (the linked benchmark binaries).
OUT_FILES=(
    bench/bench
    bench-kem/bench-kem
)
# Git-ignored extracted NGCC inputs: mounted read-only (when present).
RO_DIRS=(
    bench-common/ngcc/src
    bench-common/ngcc/specs
)

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DOCKERFILE_DIR="$REPO/scripts/ngcc-container"
read -ra DOCKER <<<"${NGCC_DOCKER:-docker}"

SELF_TEST=0
if [ "${1:-}" = "--self-test" ]; then
    SELF_TEST=1
    shift
elif [ $# -eq 0 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"
    [ $# -eq 0 ] && exit 2 || exit 0
fi

TAG="nist-sigs-zoo-ngcc:$(sha256sum "$DOCKERFILE_DIR/Dockerfile" | cut -c1-12)"
if ! "${DOCKER[@]}" image inspect "$TAG" >/dev/null 2>&1; then
    echo "ngcc-run: building $TAG" >&2
    "${DOCKER[@]}" build -q --build-arg "UID=$(id -u)" --build-arg "GID=$(id -g)" \
        -t "$TAG" "$DOCKERFILE_DIR" >&2
fi

ARGS=(run --rm --network none --cap-drop ALL --security-opt no-new-privileges
    --pids-limit 4096 --memory 16g --user "$(id -u):$(id -g)"
    --tmpfs /tmp:exec,size=4g -e HOME=/tmp -v "$REPO:/work:ro" -w /work)

for d in "${OUT_DIRS[@]}"; do
    mkdir -p "$REPO/$d"
    ARGS+=(-v "$REPO/$d:/work/$d:rw")
done
for f in "${OUT_FILES[@]}"; do
    # The file must exist to be bind-mounted. It is git-ignored; a missing one
    # is created empty with epoch mtime so make treats it as stale and relinks.
    if [ ! -e "$REPO/$f" ]; then
        : >"$REPO/$f"
        touch -d @0 "$REPO/$f"
    fi
    ARGS+=(-v "$REPO/$f:/work/$f:rw")
done
for d in "${RO_DIRS[@]}"; do
    if [ -d "$REPO/$d" ]; then ARGS+=(-v "$REPO/$d:/work/$d:ro"); fi
done
for v in BENCH_ITER BENCH_CYCLES BENCH_CPU; do
    if [ -n "${!v:-}" ]; then ARGS+=(-e "$v=${!v}"); fi
done
if [ -t 0 ]; then ARGS+=(-i); fi
if [ -t 0 ] && [ -t 1 ]; then ARGS+=(-t); fi

if [ "$SELF_TEST" = 1 ]; then
    ARGS+=(-e "NGCC_OUT_DIRS=${OUT_DIRS[*]}")
    set +e
    "${DOCKER[@]}" "${ARGS[@]}" "$TAG" bash -c '
fail=0
check() { # name, status
    if [ "$2" = 0 ]; then echo "PASS  $1"; else echo "FAIL  $1"; fail=1; fi
}
# (a) no network
if getent hosts example.org >/dev/null 2>&1; then r=1; else r=0; fi
check "no DNS (getent hosts example.org fails)" $r
if curl -sS -m 5 -o /dev/null https://example.org 2>/dev/null; then r=1; else r=0; fi
check "no network (curl fails)" $r
n=$(ls /sys/class/net | grep -vc "^lo$" || true)
check "only loopback interface" "$([ "$n" = 0 ] && echo 0 || echo 1)"
# (b) /work read-only except output dirs
if touch /work/.selftest 2>/dev/null; then rm -f /work/.selftest; r=1; else r=0; fi
check "/work root is read-only" $r
if touch /work/scripts/.selftest 2>/dev/null; then rm -f /work/scripts/.selftest; r=1; else r=0; fi
check "/work/scripts is read-only" $r
r=0
for d in $NGCC_OUT_DIRS; do
    if touch "/work/$d/.selftest" 2>/dev/null; then rm -f "/work/$d/.selftest"; else r=1; echo "      not writable: $d"; fi
done
check "listed output dirs are writable" $r
# (c) non-root
check "non-root (uid $(id -u))" "$([ "$(id -u)" != 0 ] && echo 0 || echo 1)"
# (d) gcc >= 14
v=$(gcc -dumpversion | cut -d. -f1)
echo "      gcc major: $v"
check "gcc >= 14" "$([ "$v" -ge 14 ] 2>/dev/null && echo 0 || echo 1)"
exit $fail
'
    exit $?
fi

exec "${DOCKER[@]}" "${ARGS[@]}" "$TAG" "$@"
