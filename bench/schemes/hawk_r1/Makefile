include ../../../bench-common/flags.mk
CC     ?= cc
CFLAGS := -Wall -Wextra -std=c11 $(BENCH_CFLAGS)
BUILD  := build
# HAWK v1.0 (NIST round 1): ref = hawk-sign/dev ac3a98c (2023-05-30, "Initial commit").
# build.py of this commit regenerates the NIST round-1 package (hawk-submission.zip)
# Optimized_Implementation/ and Reference_Implementation/ byte for byte; the round-2
# package ships the same code. bench/schemes/hawk builds the later 1b9fef5 (new keygen).
AVX2_DIR := ref/Optimized_Implementation/avx2

LIB_SRCS := hawk_kgen.c hawk_sign.c hawk_vrfy.c \
             ng_fxp.c ng_hawk.c ng_mp31.c ng_ntru.c ng_poly.c ng_zint31.c \
             sha3.c
LIB_OBJS := $(patsubst %.c, $(BUILD)/%.o, $(LIB_SRCS))
LIB      := $(BUILD)/libhawk.a

SOS := $(BUILD)/hawk_r1_512.so $(BUILD)/hawk_r1_1024.so
SHIM_FILES := hawk_r1_512_shim.c hawk_r1_1024_shim.c

.PHONY: all clean

all: check_ref $(SHIM_FILES) $(SOS)

$(SHIM_FILES): shim_template.c params.tsv
	python3 ../../gen_shims.py shim_template.c params.tsv .

check_ref:
	@if [ ! -f ref/build.py ]; then \
	    echo "ERROR: bench/schemes/hawk_r1/ref/ not populated." >&2; \
	    echo "Run: git submodule update --init bench/schemes/hawk_r1/ref" >&2; \
	    exit 1; \
	fi

# The AVX2 sources are generated by build.py. Make them real targets so that
# under make -j no object is compiled before generation has run.
GEN_SRCS := $(addprefix $(AVX2_DIR)/,$(LIB_SRCS)) $(AVX2_DIR)/hawk.h
$(BUILD)/.generated: | $(BUILD)
	@echo "Generating HAWK AVX2 sources via build.py..." >&2
	cd ref && python3 build.py
	touch $@
$(GEN_SRCS): $(BUILD)/.generated ;

$(BUILD)/%.o: $(AVX2_DIR)/%.c $(AVX2_DIR)/hawk.h | $(BUILD)
	$(CC) $(CFLAGS) -fPIC -I$(AVX2_DIR) -c $< -o $@

$(LIB): $(LIB_OBJS)
	ar rcs $@ $^

$(BUILD)/hawk_r1_512.so: hawk_r1_512_shim.c $(LIB) | $(BUILD)
	$(CC) $(CFLAGS) -fPIC -I$(AVX2_DIR) -I../.. -shared -o $@ $< $(LIB)

$(BUILD)/hawk_r1_1024.so: hawk_r1_1024_shim.c $(LIB) | $(BUILD)
	$(CC) $(CFLAGS) -fPIC -I$(AVX2_DIR) -I../.. -shared -o $@ $< $(LIB)

$(BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD)
	rm -f $(SHIM_FILES)
